# Static site: there is no .env at runtime. This template shows what goes where.

# ── PUBLIC (reaches the browser via js/config.js, generated by GitHub Actions) ──
# GitHub → Settings → Secrets and variables → Actions
SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1
SUPABASE_ANON_KEY=eyJ...anon

# ── PRIVATE (NEVER in the frontend; Supabase Edge Functions only) ──
#   supabase secrets set SERVICE_ROLE_KEY=... ALLOWED_ORIGINS=https://zsamir015.github.io
# SERVICE_ROLE_KEY=
# ALLOWED_ORIGINS=https://zsamir015.github.io
# TRUSTED_IP_HEADER=   (optional: IP header set by your proxy; if missing, the last X-Forwarded-For entry is used)
